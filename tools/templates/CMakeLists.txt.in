cmake_minimum_required(VERSION 3.20)

# ============================================================
# User-configurable section
# ============================================================
set(YOUR_APP_NAME app)
set(SHOW_CONSOLE ON)

# ============================================================
# Executable (your current build target)
# ============================================================
project(ywlib LANGUAGES CXX)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)

if (WIN32 AND !SHOW_CONSOLE)
  add_executable(${YOUR_APP_NAME} WIN32 main.cpp)
else()
  add_executable(${YOUR_APP_NAME} main.cpp)
endif()

target_compile_definitions(${YOUR_APP_NAME} PRIVATE YWLIB_COMPILE)
target_compile_features(${YOUR_APP_NAME} PRIVATE cxx_std_23)
target_include_directories(${YOUR_APP_NAME} PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/ywlib")

if (WIN32)
  target_compile_definitions(${YOUR_APP_NAME} PRIVATE NOMINMAX UNICODE _UNICODE)
  target_link_libraries(${YOUR_APP_NAME} PRIVATE dxgi d3d11 d3dcompiler d2d1 dwrite dxguid windowscodecs imm32)
endif()

target_compile_options(${YOUR_APP_NAME} PRIVATE
  $<$<CXX_COMPILER_ID:MSVC>:/utf-8 /arch:AVX2>
  $<$<OR:$<CXX_COMPILER_ID:GNU>,$<CXX_COMPILER_ID:Clang>>:-finput-charset=UTF-8 -fexec-charset=UTF-8 -mavx2>
)

if (CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND WIN32)
  target_link_libraries(${YOUR_APP_NAME} PRIVATE stdc++exp)
endif()

# ============================================================
# Umbrella generation
#   - ywlib/ywlib : includes yw/*.h, *.hpp
#   - ywlib/ywxlib: includes ywx/*.h, *.hpp (for Windows)
# ============================================================
find_package(Python3 COMPONENTS Interpreter REQUIRED)

set(YW_GEN_SCRIPT "${CMAKE_CURRENT_SOURCE_DIR}/tools/gen_umbrella.py")

# ----- ywlib/ywlib -----
set(YW_DIR      "${CMAKE_CURRENT_SOURCE_DIR}/ywlib/yw")
set(YW_UMBRELLA "${CMAKE_CURRENT_SOURCE_DIR}/ywlib/ywlib")

file(GLOB YW_HEADERS CONFIGURE_DEPENDS "${YW_DIR}/*.h" "${YW_DIR}/*.hpp")

add_custom_command(
  OUTPUT "${YW_UMBRELLA}"
  COMMAND "${Python3_EXECUTABLE}" "${YW_GEN_SCRIPT}"
          --in-dir "${YW_DIR}"
          --out "${YW_UMBRELLA}"
          --prefix "yw"
  DEPENDS ${YW_HEADERS} "${YW_GEN_SCRIPT}"
  VERBATIM
)

add_custom_target(ywlib_umbrella_yw DEPENDS "${YW_UMBRELLA}")

# ----- ywlib/ywxlib -----
if (WIN32)
  set(YWX_DIR      "${CMAKE_CURRENT_SOURCE_DIR}/ywlib/ywx")
  set(YWX_UMBRELLA "${CMAKE_CURRENT_SOURCE_DIR}/ywlib/ywxlib")

  file(GLOB YWX_HEADERS CONFIGURE_DEPENDS "${YWX_DIR}/*.h" "${YWX_DIR}/*.hpp")

  add_custom_command(
    OUTPUT "${YWX_UMBRELLA}"
    COMMAND "${Python3_EXECUTABLE}" "${YW_GEN_SCRIPT}"
            --in-dir "${YWX_DIR}"
            --out "${YWX_UMBRELLA}"
            --prefix "ywx"
            --preamble "#include <ywlib>"
    DEPENDS ${YWX_HEADERS} "${YW_GEN_SCRIPT}"
    VERBATIM
  )

  add_custom_target(ywlib_umbrella_ywx DEPENDS "${YWX_UMBRELLA}")
  add_custom_target(ywlib_umbrellas ALL)
  add_dependencies(ywlib_umbrellas ywlib_umbrella_yw ywlib_umbrella_ywx)
else()
  add_custom_target(ywlib_umbrellas ALL)
  add_dependencies(ywlib_umbrellas ywlib_umbrella_yw)
endif()

add_dependencies(${YOUR_APP_NAME} ywlib_umbrellas)
